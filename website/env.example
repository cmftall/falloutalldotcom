# =============================================================================
# ENVIRONMENT VARIABLES CONFIGURATION
# =============================================================================
# Copy this file to .env.local for local development
# For production, set these variables in your hosting platform (Vercel, Netlify, etc.)
#
# All variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# Variables without NEXT_PUBLIC_ are server-side only
# =============================================================================

# -----------------------------------------------------------------------------
# ANALYTICS CONFIGURATION (OPTIONAL)
# -----------------------------------------------------------------------------
# These are optional but recommended for production to track website performance
# and user behavior. Leave empty if you don't want to use analytics.

# Google Analytics 4 Tracking ID
# Required format: G-XXXXXXXXXX
# Get it from: https://analytics.google.com/
# Status: OPTIONAL - Analytics will be disabled if not set
NEXT_PUBLIC_GA_TRACKING_ID=G-XXXXXXXXXX

# Plausible Analytics Domain
# Your domain as registered in Plausible (e.g., falloutall.com)
# Get it from: https://plausible.io/
# Status: OPTIONAL - Analytics will be disabled if not set
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=yourdomain.com

# -----------------------------------------------------------------------------
# GOOGLE SEARCH CONSOLE VERIFICATION (OPTIONAL)
# -----------------------------------------------------------------------------
# Used to verify site ownership in Google Search Console
# Get it from: https://search.google.com/search-console
# Status: OPTIONAL - Search Console verification will be skipped if not set
GOOGLE_VERIFICATION_CODE=your_verification_code

# -----------------------------------------------------------------------------
# ERROR MONITORING - SENTRY (OPTIONAL)
# -----------------------------------------------------------------------------
# Sentry provides error tracking and performance monitoring
# Get these values from: https://sentry.io/
# Status: OPTIONAL - Errors will only be logged to console if not configured

# Sentry DSN (Data Source Name) - Public key for error reporting
# Format: https://xxxxx@xxxxx.ingest.sentry.io/xxxxx
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn_here

# Sentry Organization slug (for source maps upload during build)
# Only needed if you want to upload source maps for better error debugging
SENTRY_ORG=your_sentry_org

# Sentry Project slug (for source maps upload during build)
SENTRY_PROJECT=your_sentry_project

# Sentry Auth Token (for source maps upload during build)
# Generate at: https://sentry.io/settings/account/api/auth-tokens/
# Needs 'project:releases' scope
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# -----------------------------------------------------------------------------
# SECURITY HEADERS (OPTIONAL)
# -----------------------------------------------------------------------------
# Set to 'true' only if you're NOT using static export
# For static exports (current setup), headers are configured via _headers file
# Status: OPTIONAL - Default is 'false' for static export
NEXT_PUBLIC_USE_HEADERS=false

# -----------------------------------------------------------------------------
# SITE CONFIGURATION (REQUIRED FOR PRODUCTION)
# -----------------------------------------------------------------------------
# These should match your actual production domain

# Your website's full URL (with https://)
# Used for SEO metadata, sitemap generation, and canonical URLs
# Status: REQUIRED for production
# ⚠️ IMPORTANT: Update this with your actual production domain
NEXT_PUBLIC_SITE_URL=https://falloutall.com

# Your site name (used in metadata)
# Status: REQUIRED for production
# ⚠️ IMPORTANT: Update this with your actual site name
NEXT_PUBLIC_SITE_NAME="Fallou TALL"

# -----------------------------------------------------------------------------
# ENVIRONMENT
# -----------------------------------------------------------------------------
# Set to 'production' for production builds
# Set to 'development' for local development (Next.js sets this automatically)
# Status: Usually set automatically by Next.js, but can be overridden
NODE_ENV=production
